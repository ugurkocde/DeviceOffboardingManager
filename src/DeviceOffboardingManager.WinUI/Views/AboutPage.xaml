<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="DeviceOffboardingManager.WinUI.Views.AboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid x:Name="AboutPageRoot" RowSpacing="16">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="WindowWidthStates">
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="600" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="AboutActions.Orientation" Value="Vertical" />
                            <Setter Target="AboutActions.HorizontalAlignment" Value="Left" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Device Offboarding Manager" Style="{StaticResource TitleTextBlockStyle}" x:Uid="AboutPage_TextBlockDeviceOffboardingManager" />
                <TextBlock x:Name="AboutVersionText" AutomationProperties.AutomationId="AboutVersionText" Text="{x:Bind ViewModel.AboutVersionText, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="What this app does" Style="{StaticResource SubtitleTextBlockStyle}" x:Uid="AboutPage_TextBlockWhatThisAppDoes" />
                    <TextBlock Text="Device Offboarding Manager correlates devices across Intune, Autopilot, Entra ID, and optional Defender for Endpoint, then provides auditable offboarding workflows and recovery-key handling." TextWrapping="Wrap" x:Uid="AboutPage_TextBlockDeviceOffboardingManagerCorrelatesDevices" />
                    <TextBlock Text="This native app replaces the PowerShell module as of 0.4.0 and is the sole supported surface going forward." TextWrapping="Wrap" x:Uid="AboutPage_TextBlockThisNativeAppReplacesThe" />
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Validation" Style="{StaticResource SubtitleTextBlockStyle}" x:Uid="AboutPage_TextBlockValidation" />
                    <TextBlock Text="Build on Windows with Visual Studio 2022, WinUI application development, Desktop development with C++, .NET 10 SDK, Developer Mode, and Windows App Runtime installed or available through the Windows App SDK deployment manager." TextWrapping="Wrap" x:Uid="AboutPage_TextBlockBuildOnWindowsWithVisual" />
                    <StackPanel x:Name="AboutActions" Orientation="Horizontal" Spacing="8">
                        <Button Content="Open changelog" Click="OpenChangelog_Click" AutomationProperties.AutomationId="BtnOpenChangelog" x:Uid="AboutPage_BtnOpenChangelog" />
                        <Button Content="Check updates" Click="CheckForUpdates_Click" AutomationProperties.AutomationId="BtnCheckUpdates" x:Uid="AboutPage_BtnCheckUpdates" />
                        <Button Content="Open repository" Command="{x:Bind ViewModel.OpenRepositoryCommand}" AutomationProperties.AutomationId="BtnOpenRepository" x:Uid="AboutPage_BtnOpenRepository" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
