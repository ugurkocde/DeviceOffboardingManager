<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="DeviceOffboardingManager.WinUI.Views.PlaybooksPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:DeviceOffboardingManager.WinUI.Models">

    <Grid x:Name="PlaybooksPageRoot" RowSpacing="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="800" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PlaybookBox.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="PlaybookParameterBox.(Grid.Row)" Value="1" />
                        <Setter Target="PlaybookParameterBox.(Grid.Column)" Value="0" />
                        <Setter Target="PlaybookParameterBox.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="PlaybookActions.(Grid.Row)" Value="1" />
                        <Setter Target="PlaybookActions.(Grid.Column)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Playbooks" Style="{StaticResource TitleTextBlockStyle}" x:Uid="PlaybooksPage_TextBlockPlaybooks" />
            <TextBlock Text="Run native reports for Autopilot gaps, stale devices, OS posture, recovery-key metadata, and corporate identifiers." TextWrapping="Wrap" x:Uid="PlaybooksPage_TextBlockRunNativeReportsForAutopilot" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ComboBox x:Name="PlaybookBox" AutomationProperties.AutomationId="PlaybookBox" Header="Playbook" ItemsSource="{x:Bind ViewModel.PlaybookNames, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedPlaybookIndex, Mode=TwoWay}" x:Uid="PlaybooksPage_PlaybookBox" />
            <TextBox x:Name="PlaybookParameterBox" AutomationProperties.AutomationId="PlaybookParameterBox" Grid.Column="1" Header="Parameter" PlaceholderText="Used by OS-specific playbook" Text="{x:Bind ViewModel.PlaybookParameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:Uid="PlaybooksPage_PlaybookParameterBox" />
            <StackPanel x:Name="PlaybookActions" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" AutomationProperties.AutomationId="PlaybooksBusyIndicator" AutomationProperties.Name="Playbook operation in progress" x:Uid="PlaybooksPage_PlaybooksBusyIndicator" />
                <Button Content="Run playbook" Command="{x:Bind ViewModel.RunPlaybookCommand}" AutomationProperties.AutomationId="BtnRunPlaybook" AccessKey="R" x:Uid="PlaybooksPage_BtnRunPlaybook" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PlaybookStatusText" AutomationProperties.AutomationId="PlaybookStatusText" Text="{x:Bind ViewModel.PlaybookStatusText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Export last result" Command="{x:Bind ViewModel.ExportLastPlaybookCommand}" AutomationProperties.AutomationId="BtnExportLastPlaybook" x:Uid="PlaybooksPage_BtnExportLastPlaybook" />
                </Grid>
                <ListView x:Name="PlaybookResultListView" AutomationProperties.AutomationId="PlaybookResultListView" Grid.Row="1" ItemsSource="{x:Bind ViewModel.PlaybookRows, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TextRow">
                            <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
