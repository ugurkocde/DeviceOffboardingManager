<Page
    x:Class="DeviceOffboardingManager.WinUI.Views.PlaybooksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DeviceOffboardingManager.WinUI.Models">

    <Grid x:Name="PlaybooksPageRoot" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Playbooks" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Run native reports for Autopilot gaps, stale devices, OS posture, recovery-key metadata, and corporate identifiers." TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="PlaybookBox" AutomationProperties.AutomationId="PlaybookBox" Header="Playbook" ItemsSource="{x:Bind ViewModel.PlaybookNames, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedPlaybookIndex, Mode=TwoWay}" />
            <TextBox x:Name="PlaybookParameterBox" AutomationProperties.AutomationId="PlaybookParameterBox" Grid.Column="1" Header="Parameter" PlaceholderText="Used by OS-specific playbook" Text="{x:Bind ViewModel.PlaybookParameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Content="Run playbook" Command="{x:Bind ViewModel.RunPlaybookCommand}" AutomationProperties.AutomationId="BtnRunPlaybook" VerticalAlignment="Bottom" />
        </Grid>

        <Border Grid.Row="2" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PlaybookStatusText" AutomationProperties.AutomationId="PlaybookStatusText" Text="{x:Bind ViewModel.PlaybookStatusText, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Export last result" Command="{x:Bind ViewModel.ExportLastPlaybookCommand}" AutomationProperties.AutomationId="BtnExportLastPlaybook" />
                </Grid>
                <ListView x:Name="PlaybookResultListView" AutomationProperties.AutomationId="PlaybookResultListView" Grid.Row="1" ItemsSource="{x:Bind ViewModel.PlaybookRows, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:TextRow">
                            <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
