<Window
    x:Class="DeviceOffboardingManager.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Title="Device Offboarding Manager">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <muxc:NavigationView
            x:Name="RootNavigation"
            AutomationProperties.AutomationId="RootNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            SelectionChanged="RootNavigation_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem x:Name="NavHome" Content="Home" Tag="home" AutomationProperties.AutomationId="NavHome">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavDashboard" Content="Dashboard" Tag="dashboard" AutomationProperties.AutomationId="NavDashboard">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavDevices" Content="Devices" Tag="devices" AutomationProperties.AutomationId="NavDevices">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE975;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavOffboarding" Content="Offboarding" Tag="offboarding" AutomationProperties.AutomationId="NavOffboarding">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavPlaybooks" Content="Playbooks" Tag="playbooks" AutomationProperties.AutomationId="NavPlaybooks">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>
            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem x:Name="NavAbout" Content="About" Tag="about" AutomationProperties.AutomationId="NavAbout">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <Grid RowSpacing="16" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <muxc:InfoBar
                    x:Name="StatusInfoBar"
                    AutomationProperties.AutomationId="StatusInfoBar"
                    IsOpen="True"
                    Severity="Informational"
                    Title="Not connected"
                    Message="Configure authentication, connect to Microsoft Graph, then search devices." />

                <ScrollViewer Grid.Row="1">
                    <Grid MaxWidth="1280">
                        <Grid x:Name="HomePage" RowSpacing="16" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Device Offboarding Manager" Style="{StaticResource TitleTextBlockStyle}" />
                                    <TextBlock Text="Native Windows app for Intune, Autopilot, Entra ID, and optional Defender for Endpoint offboarding." TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                    <Button x:Name="HomeConnectButton" Content="Connect" Click="Connect_Click" AutomationProperties.AutomationId="BtnHomeConnect" />
                                    <Button Content="Search devices" Tag="devices" Click="NavigateButton_Click" AutomationProperties.AutomationId="BtnHomeDevices" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Release posture" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="Version 0.4 is the native signed-app track. Test with non-production devices first; offboarding, wipe, delete, and Defender actions can be permanent." TextWrapping="Wrap" />
                                    <TextBlock Text="The v0.3 PowerShell module remains available for automation and compatibility while the WinUI app moves toward MSIX, Intune, WinGet, and Microsoft Store distribution." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Intune" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="Search managed devices, retire or wipe, delete records, report stale devices, and read compliance/agent state." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Autopilot" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="Correlate identities, delete Autopilot records, and set or clear group tags for selected devices." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Entra ID" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="Resolve exact device IDs, disable or delete device objects, and preserve IDs in exports and confirmation flows." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Defender" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="Optional, settings-gated Defender for Endpoint offboarding that requests Defender tokens only when used." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid x:Name="DashboardPage" RowSpacing="16" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}" />
                                    <TextBlock Text="Tenant-wide device posture for Intune, Autopilot, Entra ID, stale devices, and ownership." TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                    <ComboBox x:Name="DashboardPlatformFilter" AutomationProperties.AutomationId="DashboardPlatformFilter" Header="Platform" SelectedIndex="0" Width="180">
                                        <ComboBoxItem Content="All platforms" />
                                        <ComboBoxItem Content="Windows" />
                                        <ComboBoxItem Content="macOS" />
                                        <ComboBoxItem Content="iOS" />
                                        <ComboBoxItem Content="Android" />
                                        <ComboBoxItem Content="Linux" />
                                    </ComboBox>
                                    <Button x:Name="DashboardRefreshButton" AutomationProperties.AutomationId="DashboardRefreshButton" Content="Refresh" Click="RefreshDashboard_Click" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Intune" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock x:Name="IntuneCountText" AutomationProperties.AutomationId="IntuneCountText" Text="--" Style="{StaticResource TitleTextBlockStyle}" />
                                        <Button Content="View" Tag="intune" Click="DashboardCard_Click" AutomationProperties.AutomationId="BtnViewIntune" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Autopilot" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock x:Name="AutopilotCountText" AutomationProperties.AutomationId="AutopilotCountText" Text="--" Style="{StaticResource TitleTextBlockStyle}" />
                                        <Button Content="View" Tag="autopilot" Click="DashboardCard_Click" AutomationProperties.AutomationId="BtnViewAutopilot" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Entra ID" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock x:Name="EntraCountText" AutomationProperties.AutomationId="EntraCountText" Text="--" Style="{StaticResource TitleTextBlockStyle}" />
                                        <Button Content="View" Tag="entra" Click="DashboardCard_Click" AutomationProperties.AutomationId="BtnViewEntra" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Stale 90 days" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock x:Name="Stale90Text" AutomationProperties.AutomationId="Stale90Text" Text="--" Style="{StaticResource TitleTextBlockStyle}" />
                                        <Button Content="View" Tag="stale90" Click="DashboardCard_Click" AutomationProperties.AutomationId="BtnViewStale90" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Stale 30 days" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock x:Name="Stale30Text" AutomationProperties.AutomationId="Stale30Text" Text="--" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <Button Content="View" Tag="stale30" Click="DashboardCard_Click" AutomationProperties.AutomationId="BtnViewStale30" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Stale 180 days" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock x:Name="Stale180Text" AutomationProperties.AutomationId="Stale180Text" Text="--" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <Button Content="View" Tag="stale180" Click="DashboardCard_Click" AutomationProperties.AutomationId="BtnViewStale180" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Corporate" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock x:Name="CorporateCountText" AutomationProperties.AutomationId="CorporateCountText" Text="--" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <Button Content="View" Tag="corporate" Click="DashboardCard_Click" AutomationProperties.AutomationId="BtnViewCorporate" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Personal" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock x:Name="PersonalCountText" AutomationProperties.AutomationId="PersonalCountText" Text="--" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <Button Content="View" Tag="personal" Click="DashboardCard_Click" AutomationProperties.AutomationId="BtnViewPersonal" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="3" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Distribution" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock x:Name="DashboardPlatformText" AutomationProperties.AutomationId="DashboardPlatformText" Text="Refresh the dashboard to show platform distribution." TextWrapping="Wrap" />
                                        <TextBlock x:Name="DashboardOwnershipText" AutomationProperties.AutomationId="DashboardOwnershipText" Text="Ownership distribution is not loaded." TextWrapping="Wrap" />
                                        <ProgressBar x:Name="CorporateDevicesProgress" AutomationProperties.AutomationId="CorporateDevicesProgress" Minimum="0" Maximum="100" />
                                        <ProgressBar x:Name="PersonalDevicesProgress" AutomationProperties.AutomationId="PersonalDevicesProgress" Minimum="0" Maximum="100" />
                                        <TextBlock x:Name="DashboardStaleText" AutomationProperties.AutomationId="DashboardStaleText" Text="Stale device ratios are not loaded." TextWrapping="Wrap" />
                                        <ProgressBar x:Name="StaleDevices30Progress" AutomationProperties.AutomationId="StaleDevices30Progress" Minimum="0" Maximum="100" />
                                        <ProgressBar x:Name="StaleDevices90Progress" AutomationProperties.AutomationId="StaleDevices90Progress" Minimum="0" Maximum="100" />
                                        <ProgressBar x:Name="StaleDevices180Progress" AutomationProperties.AutomationId="StaleDevices180Progress" Minimum="0" Maximum="100" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="DashboardResultTitleText" AutomationProperties.AutomationId="DashboardResultTitleText" Text="Dashboard drilldown" Style="{StaticResource SubtitleTextBlockStyle}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <Button Content="Open in devices" Click="OpenDashboardResultsInDevices_Click" AutomationProperties.AutomationId="BtnOpenDashboardResultsInDevices" />
                                                <Button Content="Export" Click="ExportDashboardResults_Click" AutomationProperties.AutomationId="BtnExportDashboardResults" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="DashboardResultSummaryText" AutomationProperties.AutomationId="DashboardResultSummaryText" Text="Select a dashboard card to preview matching devices." TextWrapping="Wrap" />
                                        <ListView x:Name="DashboardResultListView" AutomationProperties.AutomationId="DashboardResultListView" MinHeight="160" MaxHeight="260">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="4" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Readiness" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="DashboardReadinessText" AutomationProperties.AutomationId="DashboardReadinessText" Text="Connect to Microsoft Graph to refresh dashboard statistics. Defender remains optional and disabled until enabled in Settings." TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Open settings" Tag="settings" Click="NavigateButton_Click" AutomationProperties.AutomationId="BtnDashboardSettings" />
                                        <Button Content="Go to devices" Tag="devices" Click="NavigateButton_Click" AutomationProperties.AutomationId="BtnDashboardDevices" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid x:Name="DevicesPage" RowSpacing="12" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Devices" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="Search, correlate, filter, select, and export device records before offboarding." TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SearchModeBox" AutomationProperties.AutomationId="SearchModeBox" Header="Search mode" SelectedIndex="0">
                                    <ComboBoxItem Content="Device Name" />
                                    <ComboBoxItem Content="Serial Number" />
                                    <ComboBoxItem Content="Device ID" />
                                    <ComboBoxItem Content="Contains" />
                                </ComboBox>
                                <TextBox x:Name="SearchTextBox" AutomationProperties.AutomationId="SearchTextBox" Grid.Column="1" Header="Search terms" PlaceholderText="Comma or line separated device names, serials, or IDs" AcceptsReturn="True" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                    <Button x:Name="SearchButton" AutomationProperties.AutomationId="SearchButton" Content="Search" Click="Search_Click" />
                                    <Button x:Name="ImportBulkButton" AutomationProperties.AutomationId="ImportBulkButton" Content="Import file" Click="ImportBulkFile_Click" />
                                    <Button x:Name="BulkTemplateButton" AutomationProperties.AutomationId="BulkTemplateButton" Content="Save template" Click="DownloadBulkTemplate_Click" />
                                    <Button x:Name="ClearSearchButton" AutomationProperties.AutomationId="ClearSearchButton" Content="Clear" Click="ClearSearch_Click" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="SelectAllDevicesBox" AutomationProperties.AutomationId="SelectAllDevicesBox" Content="All" Click="SelectAllDevices_Click" VerticalAlignment="Bottom" />
                                <TextBox x:Name="FilterDeviceNameBox" AutomationProperties.AutomationId="FilterDeviceNameBox" Grid.Column="1" Header="Device" TextChanged="DeviceFilter_TextChanged" />
                                <TextBox x:Name="FilterSerialBox" AutomationProperties.AutomationId="FilterSerialBox" Grid.Column="2" Header="Serial" TextChanged="DeviceFilter_TextChanged" />
                                <TextBox x:Name="FilterOsBox" AutomationProperties.AutomationId="FilterOsBox" Grid.Column="3" Header="OS" TextChanged="DeviceFilter_TextChanged" />
                                <TextBox x:Name="FilterUserBox" AutomationProperties.AutomationId="FilterUserBox" Grid.Column="4" Header="User" TextChanged="DeviceFilter_TextChanged" />
                                <TextBox x:Name="FilterComplianceBox" AutomationProperties.AutomationId="FilterComplianceBox" Grid.Column="5" Header="Compliance" TextChanged="DeviceFilter_TextChanged" />
                                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                    <Button Content="Reset filters" Click="ResetFilters_Click" AutomationProperties.AutomationId="BtnResetFilters" />
                                    <Button Content="View groups" Click="ViewSelectedGroups_Click" AutomationProperties.AutomationId="BtnViewSelectedGroups" />
                                    <Button Content="Export CSV" Click="ExportCsv_Click" AutomationProperties.AutomationId="BtnExportDevicesCsv" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="SearchStatusText" AutomationProperties.AutomationId="SearchStatusText" Grid.Row="3" Text="No devices searched yet." TextWrapping="Wrap" />

                            <ListView x:Name="DeviceListView" AutomationProperties.AutomationId="DeviceListView" Grid.Row="4" MinHeight="420" SelectionMode="None">
                                <ListView.Header>
                                    <Grid ColumnSpacing="8" Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="Device" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Grid.Column="2" Text="Serial" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Grid.Column="3" Text="OS" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Grid.Column="4" Text="User" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Grid.Column="5" Text="Compliance" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Grid.Column="6" Text="Services" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Grid.Column="7" Text="IDs" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </Grid>
                                </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8" Margin="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox AutomationProperties.AutomationId="DeviceRowSelectionBox" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="DeviceSelectionChanged_Click" />
                                            <TextBlock Grid.Column="1" Text="{Binding DeviceName}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding SerialNumber}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="3" Text="{Binding OperatingSystem}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="4" Text="{Binding PrimaryUser}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="5" Text="{Binding ComplianceState}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="6" Text="{Binding ServiceSummary}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="7" Text="{Binding EntraDeviceObjectId}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <Grid x:Name="OffboardingPage" RowSpacing="16" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Offboarding" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="Run selected pre-actions and service removals only after reviewing resolved IDs." TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Row="1" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Selected devices" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock x:Name="SelectedDeviceCountText" AutomationProperties.AutomationId="SelectedDeviceCountText" Text="No devices selected." TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Review IDs" Click="ReviewSelectedIds_Click" AutomationProperties.AutomationId="BtnReviewSelectedIds" />
                                        <Button Content="Export selected" Click="ExportCsv_Click" AutomationProperties.AutomationId="BtnExportSelected" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Service actions" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <CheckBox x:Name="DeleteEntraBox" AutomationProperties.AutomationId="DeleteEntraBox" Content="Remove from Entra ID" IsChecked="True" />
                                        <CheckBox x:Name="DisableEntraBox" AutomationProperties.AutomationId="DisableEntraBox" Content="Disable in Entra ID instead of removal" />
                                        <CheckBox x:Name="DeleteIntuneBox" AutomationProperties.AutomationId="DeleteIntuneBox" Content="Remove from Intune" IsChecked="True" />
                                        <CheckBox x:Name="DeleteAutopilotBox" AutomationProperties.AutomationId="DeleteAutopilotBox" Content="Remove from Autopilot" IsChecked="True" />
                                        <CheckBox x:Name="OffboardDefenderBox" AutomationProperties.AutomationId="OffboardDefenderBox" Content="Offboard Defender for Endpoint" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Pre-actions and recovery" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <ComboBox x:Name="PreActionBox" AutomationProperties.AutomationId="PreActionBox" Header="Intune pre-action" SelectedIndex="0">
                                            <ComboBoxItem Content="None" />
                                            <ComboBoxItem Content="Retire Intune device" />
                                            <ComboBoxItem Content="Wipe Intune device" />
                                        </ComboBox>
                                        <TextBox x:Name="GroupTagBox" AutomationProperties.AutomationId="GroupTagBox" Header="Autopilot group tag" PlaceholderText="New tag or empty to clear" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Set group tag" Click="SetGroupTag_Click" AutomationProperties.AutomationId="BtnSetGroupTag" />
                                            <Button Content="Fetch recovery keys" Click="FetchRecoveryKeys_Click" AutomationProperties.AutomationId="BtnFetchRecoveryKeys" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="3" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="OffboardingStatusText" AutomationProperties.AutomationId="OffboardingStatusText" Text="Select devices before running actions." TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="Run offboarding" Click="RunOffboarding_Click" AutomationProperties.AutomationId="BtnRunOffboarding" />
                                        <Button Content="Export HTML report" Click="ExportReport_Click" AutomationProperties.AutomationId="BtnExportHtmlReport" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="PlaybooksPage" RowSpacing="16" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Playbooks" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="Run native reports for Autopilot gaps, stale devices, OS posture, recovery-key metadata, and corporate identifiers." TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="340" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="PlaybookBox" AutomationProperties.AutomationId="PlaybookBox" Header="Playbook" />
                                <TextBox x:Name="PlaybookParameterBox" AutomationProperties.AutomationId="PlaybookParameterBox" Grid.Column="1" Header="Parameter" PlaceholderText="Used by OS-specific playbook" />
                                <Button Grid.Column="2" Content="Run playbook" Click="RunPlaybook_Click" AutomationProperties.AutomationId="BtnRunPlaybook" VerticalAlignment="Bottom" />
                            </Grid>

                            <Border Grid.Row="2" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PlaybookStatusText" AutomationProperties.AutomationId="PlaybookStatusText" Text="Run a playbook to export a CSV report to the desktop." TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Export last result" Click="ExportLastPlaybook_Click" AutomationProperties.AutomationId="BtnExportLastPlaybook" />
                                    </Grid>
                                    <ListView x:Name="PlaybookResultListView" AutomationProperties.AutomationId="PlaybookResultListView" MinHeight="360">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid x:Name="SettingsPage" RowSpacing="16" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="Authentication, app registration import, Defender gating, and required permissions." TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Grid.Row="1" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                <Grid RowSpacing="12" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ComboBox x:Name="AuthMethodBox" AutomationProperties.AutomationId="AuthMethodBox" Header="Authentication method" SelectedIndex="0">
                                        <ComboBoxItem Content="Interactive" />
                                        <ComboBoxItem Content="Device code" />
                                        <ComboBoxItem Content="Certificate" />
                                        <ComboBoxItem Content="Client secret" />
                                    </ComboBox>
                                    <TextBox x:Name="TenantIdBox" AutomationProperties.AutomationId="TenantIdBox" Grid.Column="1" Header="Tenant ID" PlaceholderText="Tenant ID or organizations" />
                                    <TextBox x:Name="ClientIdBox" AutomationProperties.AutomationId="ClientIdBox" Grid.Row="1" Header="Client ID" PlaceholderText="App registration client ID" />
                                    <TextBox x:Name="CertificateThumbprintBox" AutomationProperties.AutomationId="CertificateThumbprintBox" Grid.Row="1" Grid.Column="1" Header="Certificate thumbprint" />
                                    <PasswordBox x:Name="ClientSecretBox" AutomationProperties.AutomationId="ClientSecretBox" Grid.Row="2" Header="Client secret (session only)" />
                                    <ToggleSwitch x:Name="DefenderToggle" AutomationProperties.AutomationId="DefenderToggle" Grid.Row="2" Grid.Column="1" Header="Defender for Endpoint integration" />

                                    <TextBox x:Name="ConfigPathBox" AutomationProperties.AutomationId="ConfigPathBox" Grid.Row="3" Grid.ColumnSpan="2" Header="Config JSON path" PlaceholderText="Select or paste an app registration config JSON path for import" />
                                    <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                        <Button Content="Browse" Click="BrowseConfig_Click" AutomationProperties.AutomationId="BtnBrowseConfig" />
                                        <Button Content="Import" Click="ImportConfig_Click" AutomationProperties.AutomationId="BtnImportConfig" />
                                        <Button Content="Save" Click="SaveSettings_Click" AutomationProperties.AutomationId="BtnSaveSettings" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="ConnectButton" AutomationProperties.AutomationId="ConnectButton" Content="Connect" Click="Connect_Click" />
                                        <Button x:Name="DisconnectButton" AutomationProperties.AutomationId="DisconnectButton" Content="Disconnect" Click="Disconnect_Click" IsEnabled="False" />
                                        <Button Content="Open audit log" Click="OpenAuditLog_Click" AutomationProperties.AutomationId="BtnOpenAuditLog" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Required permissions" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="PermissionsText" AutomationProperties.AutomationId="PermissionsText" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Distribution readiness" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="v0.4 targets signed MSIX or EXE releases first, then Intune packaging, WinGet, and Microsoft Store submission after functional and privacy review." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid x:Name="AboutPage" RowSpacing="16" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Device Offboarding Manager" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock x:Name="AboutVersionText" AutomationProperties.AutomationId="AboutVersionText" Text="Version 0.4.0 native Windows app track" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Row="1" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="What this app does" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="Device Offboarding Manager correlates devices across Intune, Autopilot, Entra ID, and optional Defender for Endpoint, then provides auditable offboarding workflows and recovery-key handling." TextWrapping="Wrap" />
                                    <TextBlock Text="The PowerShell module remains the 0.3 automation and compatibility surface while this native app becomes the signed deployment surface." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Padding="16" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Validation" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="Build on Windows with Visual Studio 2022, WinUI application development, Desktop development with C++, .NET 8 SDK, Developer Mode, and Windows App Runtime installed or available through the Windows App SDK deployment manager." TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Open changelog" Click="OpenChangelog_Click" AutomationProperties.AutomationId="BtnOpenChangelog" />
                                        <Button Content="Check updates" Click="CheckForUpdates_Click" AutomationProperties.AutomationId="BtnCheckUpdates" />
                                        <Button Content="Open repository" Click="OpenRepository_Click" AutomationProperties.AutomationId="BtnOpenRepository" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
